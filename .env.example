# vertex-proxy environment variables. Copy to .env and fill in your values.
# Every setting can also go in a TOML file; see examples/config.toml.

# Google Cloud credentials: a service-account key, user credentials or a workload identity
# federation config. Leave unset to use Application Default Credentials.
VERTEX_PROXY_CREDENTIALS_PATH=/path/to/credentials.json

# GCP project. Defaults to the project named in a service-account key.
# VERTEX_PROXY_PROJECT_ID=my-gcp-project

# Locations: global, a multi-region (us, eu) or a region such as us-east5.
# Claude 4.7 and later are served only from global, us and eu.
# VERTEX_PROXY_ANTHROPIC_REGION=global
# VERTEX_PROXY_GEMINI_REGION=global
# VERTEX_PROXY_MAAS_REGION=global

# VERTEX_PROXY_HOST=127.0.0.1
# VERTEX_PROXY_PORT=8787
# VERTEX_PROXY_LOG_LEVEL=info

# Require clients to send this key (Authorization: Bearer, x-api-key or x-goog-api-key).
# VERTEX_PROXY_API_KEY=change-me

# VERTEX_PROXY_METRICS_ENABLED=true
